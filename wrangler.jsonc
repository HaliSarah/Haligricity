/*
 * Title: Haligricity Cloudflare Config
 * Author: Hali Sarah Parsons
 * Date: 2026-11-02
 * Modified By: Claude
 * Description: Deploys the Haligricity static site to its Cloudflare Worker.
 */
{
  // Must match the Worker's name, or Wrangler deploys to a different Worker.
  "name": "haligricity",
  // Keeps runtime behavior fixed so Cloudflare updates can't change it.
  "compatibility_date": "2026-10-18",
  "assets": {
    // The Build command copies the site here, keeping .git out of the upload.
    "directory": "./dist"
  }
}